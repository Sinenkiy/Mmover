<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/settings_surface">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settingsToolbar"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:minHeight="56dp" android:background="@color/settings_surface"
        app:title="@string/settings_title" app:titleTextColor="@color/glass_text"
        app:navigationIcon="@drawable/ic_arrow_back" app:navigationIconTint="@color/glass_text"
        app:navigationContentDescription="@string/back_button"
        app:layout_constraintWidth_max="@dimen/prefs_max_width"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/settingsSaveNote"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
        android:paddingBottom="8dp" android:text="@string/settings_auto_save"
        android:textSize="12sp" android:textColor="@color/glass_secondary_text"
        app:layout_constraintWidth_max="512dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settingsToolbar" />
    <FrameLayout android:id="@android:id/list_container"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintWidth_max="@dimen/prefs_max_width"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settingsSaveNote"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
